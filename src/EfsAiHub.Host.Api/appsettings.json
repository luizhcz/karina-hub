{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Hosting": "Information",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EventBuffer": {
    "InMemory": {
      "MaxLengthPerStream": 5000,
      "RetentionAfterTerminalMinutes": 30,
      "IdleEvictionAfterMinutes": 120,
      "CleanupIntervalSeconds": 60
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=efs_ai_hub;Username=efs_ai_hub;Password=change_me_in_production;Search Path=aihub",
    "PostgresReporting": ""
  },
  "AzureAI": {
    "Endpoint": "https://cerquela-ruiz-resource.services.ai.azure.com",
    "DefaultDeploymentName": "grok-4-1-fast-reasoning",
    "ApiKey": ""
  },
  "OpenAI": {
    "ApiKey": "",
    "DefaultModel": "gpt-5.4-mini"
  },
  "WorkflowEngine": {
    "MaxConcurrentExecutions": 10,
    "ChatMaxConcurrentExecutions": 1500,
    "QueueCapacity": 500,
    "AdminQueueCapacity": 300,
    "DefaultTimeoutSeconds": 300,
    "CheckpointMode": "InMemory",
    "EnableScheduledWorkflows": true,
    "HitlRecoveryConcurrency": 4,
    "HitlRecoveryBatchSize": 100,
    "AuditRetentionDays": 30,
    "ToolInvocationRetentionDays": 14,
    "CheckpointRetentionDays": 14
  },
  "OpenTelemetry": {
    "ServiceName": "efs-ai-hub",
    "OtlpEndpoint": "http://localhost:4317",
    "EnableSensitiveData": false
  },
  "Npgsql": {
    "SseMaxPoolSize": 10,
    "ReportingMaxPoolSize": 20,
    "GeneralMinPoolSize": 10,
    "GeneralMaxPoolSize": 350
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "efs-ai-hub:",
    "DefinitionCacheTtlSeconds": 300
  },
  "AtivoAnalysis": {
    "IntervalHours": 24,
    "RotationDays": 20,
    "DelayBetweenTriggersMs": 2000
  },
  "Admin": {
    "GateEnabled": true,
    "AdminPermissions": []
  },
  "UserProvisioning": {
    "SkipAnonymousRoutes": true,
    "SkipPathPrefixes": ["/api/aihub/chat/ag-ui"],
    "SkipPathPatterns": [
      "^/api/aihub/ingestions(/.*)?$",
      "^/api/aihub/responses(/[^/]+)?$",
      "^/api/aihub/workflows/[^/]+/trigger$"
    ]
  },
  "Sharing": {
    "Enabled": true,
    "CrossProjectEnabled": true,
    "WhitelistEnabled": true,
    "AuditCrossInvoke": true,
    "CrossInvokeAuditThrottleSeconds": 60
  },
  "CircuitBreaker": {
    "Enabled": true,
    "FailureThreshold": 5,
    "OpenDurationSeconds": 30,
    "HalfOpenTimeoutSeconds": 10,
    "EffectiveReplicaCount": 1
  },
  "ChatRouting": {
    "DefaultWorkflows": {
      "cliente": "atendimento-cliente",
      "admin": "atendimento-assessor"
    }
  },
  "DocumentIntelligence": {
    "Endpoint": "https://efs-ai-hub-resource.cognitiveservices.azure.com",
    "UseManagedIdentity": true,
    "DefaultModel": "prebuilt-layout",
    "PollingTimeoutSeconds": 180,
    "GateWaitTimeoutSeconds": 600,
    "CacheTtlDays": 1,
    "MaxConcurrentExtractions": 4
  },
  "IngestionApi": {
    "Enabled": false,
    "DownloadTimeoutSeconds": 120,
    "MaxRedirects": 2,
    "MaxSizeBytes": 104857600
  },
  "WebhookDelivery": {
    "Enabled": true,
    "BatchSize": 25,
    "DeliveryTimeoutSeconds": 10,
    "PollIdleSeconds": 5,
    "MaxConcurrentDeliveries": 10,
    "DeliveringTimeoutSeconds": 300
  },
  "GenericTools": {
    "DefaultTimeoutSeconds": 120,
    "MaxTimeoutSeconds": 120
  },
  "StandalonePools": {
    "Enabled": false,
    "GlobalConcurrency": 120,
    "DefaultMaxConcurrentPerWorkflow": 12,
    "LeaseTtlSeconds": 30,
    "HeartbeatSeconds": 10,
    "PollIdleSeconds": 5,
    "BatchSize": 25,
    "MaxAttempts": 3,
    "RetryBackoffBaseSeconds": 5,
    "ReaperIntervalSeconds": 30,
    "ReaperReclaimBackoffSeconds": 5,
    "PollingRateLimitPerMinute": 60,
    "JobMaxLifetimeMinutes": 30
  },
  "Persona": {
    "BaseUrl": "",
    "ApiKey": "",
    "AuthScheme": "Bearer",
    "TimeoutSeconds": 3,
    "CacheTtlMinutes": 5,
    "LocalCacheTtlSeconds": 60,
    "Disabled": true
  },
  "Azure": {
    "ServicePrincipal": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Secrets": {
    "Aws": {
      "Region": "",
      "RetryAttempts": 3,
      "L1TtlSeconds": 60,
      "L2TtlSeconds": 300,
      "L1MaxEntries": 500,
      "CacheKeyPrefix": "secret:",
      "HealthCheckCanaryReference": ""
    },
    "Bootstrap": {}
  },
  "EfsAiHub": {
    "PublicBaseUrl": "",
    "ConsumeHeaders": [
      { "Key": "app_origin", "Value": "external-consumer" },
      { "Key": "access_token", "Value": "<seu-bearer-token>" }
    ]
  }
}
