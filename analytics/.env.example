# ─── Analytics — exemplo de configuração local ─────────────────────────────
# Copie este arquivo pra `.env.local` (gitignored) e edite à vontade.
# Vite lê `.env.local` com precedência maior que `.env` quando o app roda
# fora do Docker via `npm run dev`.
#
# Pra configurar dentro do Docker, use build-args (ver docker-compose.yml).

# Backend da API. Vazio = usa proxy local.
# Exemplos:
#   VITE_API_HOST=http://localhost:5189         # backend rodando no host
#   VITE_API_HOST=https://api.efs.com           # backend remoto direto
# Quando setar, garanta que `Cors:AllowedOrigins` do backend libera este
# origin (appsettings.json), caso contrário browser bloqueia.
VITE_API_HOST=

# Permissions fake pra dev local sem proxy. Valor recomendado em dev:
#   VITE_DEV_PERMISSIONS=efs.admin
# NUNCA setar em prod — o proxy injeta o header real e essa env é ignorada.
VITE_DEV_PERMISSIONS=
